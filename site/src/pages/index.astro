---
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL;

const features = [
  {
    title: "Salient Memory Extraction",
    description:
      "Automatically identifies and extracts important facts, preferences, decisions, procedures, and problem solutions from conversations.",
    icon: "brain",
  },
  {
    title: "Full Provenance",
    description:
      "Every extracted memory links back to the exact conversation entries that produced it, with citations and confidence scores.",
    icon: "link",
  },
  {
    title: "Event-Driven Processing",
    description:
      "Listens to Memory Service event streams and processes conversations asynchronously with intelligent debounce windowing.",
    icon: "activity",
  },
  {
    title: "Profile Consolidation",
    description:
      "Consolidates extracted memories into structured user profiles that agents can use for personalized interactions.",
    icon: "user",
  },
  {
    title: "Memory Justification",
    description:
      "API to retrieve the full reasoning and source conversation behind any extracted memory for auditing and debugging.",
    icon: "search",
  },
  {
    title: "Built on Quarkus",
    description:
      "Fast startup, low memory footprint, and native compilation support. Connects to Memory Service via gRPC.",
    icon: "stack",
  },
];

const icons: Record<string, string> = {
  brain:
    "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  link: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  activity: "M22 12h-4l-3 9L9 3l-3 9H2",
  user: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  search: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
  stack: "M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5",
};
---

<BaseLayout title="Cognitive Memory">
  <section
    class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white dark:from-surface-900 dark:to-surface-950"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance">
          <span class="text-gray-900 dark:text-white">Intelligent Memory for</span>
          <br />
          <span class="gradient-text">AI Agents</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto text-balance">
          A cognition layer that automatically extracts salient memories from AI agent conversations and stores them with
          full provenance back into Memory Service.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`${basePath}docs/`} class="btn-primary text-lg px-8 py-3">
            Documentation
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="https://github.com/rigazilla/cognitive-memory"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-lg px-8 py-3"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">How It Works</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          The cognition processor sits between your AI agents and Memory Service, automatically turning conversations
          into structured, retrievable knowledge.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          features.map((feature) => (
            <div class="card p-6">
              <div class="w-12 h-12 rounded-lg gradient-bg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[feature.icon]} />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
              <p class="text-gray-600 dark:text-gray-400">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
