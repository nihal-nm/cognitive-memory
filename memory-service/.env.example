# Memory Service - Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# OpenAI-compatible API configuration (used by chat-quarkus sample app)
# When using Ollama, point to host machine via host.docker.internal
OPENAI_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=ollama
# Choose a lightweight model for faster responses (qwen2.5:1.5b, llama3.2, etc.)
OPENAI_MODEL=qwen2.5:1.5b

# Embedding configuration (used by memory-service for semantic search)
# Uses Ollama's OpenAI-compatible endpoint (/v1)
MEMORY_SERVICE_EMBEDDING_OPENAI_API_KEY=ollama
MEMORY_SERVICE_EMBEDDING_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Recommended embedding model (pull with: ollama pull nomic-embed-text)
MEMORY_SERVICE_EMBEDDING_OPENAI_MODEL_NAME=nomic-embed-text
