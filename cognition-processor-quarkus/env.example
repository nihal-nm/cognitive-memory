# Memory Service - Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# OpenAI-compatible API configuration (used by chat-quarkus sample app)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=<your-api-key>
OPENAI_MODEL=gpt-4o

# Embedding configuration (used by memory-service for semantic search)
MEMORY_SERVICE_EMBEDDING_OPENAI_API_KEY=<your-api-key>
MEMORY_SERVICE_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_SERVICE_EMBEDDING_OPENAI_MODEL_NAME=text-embedding-3-small
MEMORY_SERVICE_EMBEDDING_OPENAI_DIMENSIONS=1536

# Cognition Processor Configuration
# Memory model configuration (for extraction and verification)
COGNITION_OPENAI_BASE_URL=https://api.openai.com/v1
COGNITION_OPENAI_MODEL_NAME=gpt-4o
COGNITION_OPENAI_API_KEY=<your-api-key>
#Predefined api key for quickstart
# used by the cognition processor to access memory-service data
MEMORY_SERVICE_API_KEY=cognition-processor-key-123

# Worker/runtime identity
MEMORY_SERVICE_CLIENT_ID=cognition_processor
COGNITION_WORKER_ID=cognition_processor
COGNITION_RUNTIME_ID=cognition-processor-v1
COGNITION_RUNTIME_VERSION=1.0.0-SNAPSHOT
COGNITION_CHECKPOINT_RESET_ON_STARTUP=false
