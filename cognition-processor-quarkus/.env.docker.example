# Copy this file to .env.docker for local dev/test container runs.
# Values here are safe examples only. Inject real secrets at runtime.

# Memory Service connection from inside the container
MEMORY_SERVICE_GRPC_HOST=host.docker.internal
MEMORY_SERVICE_GRPC_PORT=8082

# Memory Service authentication
MEMORY_SERVICE_API_KEY=cognition-processor-key-123
MEMORY_SERVICE_CLIENT_ID=cognition_processor

# Worker/runtime identity
COGNITION_WORKER_ID=cognition_processor
COGNITION_RUNTIME_ID=cognition-processor-v1
COGNITION_RUNTIME_VERSION=1.0.0-SNAPSHOT
COGNITION_CHECKPOINT_RESET_ON_STARTUP=false

# Quarkus HTTP/logging
QUARKUS_HTTP_PORT=8090
QUARKUS_LOG_LEVEL=INFO
QUARKUS_LOG_CATEGORY__IO_GITHUB_RIGAZILLA_MEMORY__LEVEL=DEBUG
QUARKUS_LOG_CATEGORY__DEV_LANGCHAIN4J__LEVEL=DEBUG
QUARKUS_LOG_CATEGORY__IO_QUARKIVERSE_LANGCHAIN4J__LEVEL=DEBUG
QUARKUS_LOG_FILE_ENABLE=true
QUARKUS_LOG_FILE_PATH=/deployments/logs/quarkus.log

# Ollama endpoint (accessible from container)
QUARKUS_LANGCHAIN4J_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== Memory Model Configuration =====
# Used for extraction and verification
# Default: Ollama with llama3.2

# Option 1: Use Ollama (default - no additional config needed)
# MEMORY_MODEL_PROVIDER=ollama
# MEMORY_MODEL_ID=llama3.2

# Option 2: Use OpenAI-compatible endpoint
# MEMORY_MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL_NAME=gpt-4

# Option 3: Use Google Gemini
# MEMORY_MODEL_PROVIDER=vertex-ai-gemini
# MEMORY_MODEL_ID=gemini-2.5-flash-lite
# QUARKUS_LANGCHAIN4J_AI_GEMINI__MEMORY__API_KEY=your-gemini-api-key

# ===== Global LLM Defaults =====
# Used by the resource configuration system for all cognitive processes
# Default: Ollama with llama3.2

# Option 1: Use Ollama (default - no additional config needed)
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_LLM_MODEL=llama3.2
# DEFAULT_LLM_BASE_URL=http://host.docker.internal:11434

# Option 2: Use OpenAI-compatible endpoint
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=gpt-4
# DEFAULT_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# DEFAULT_LLM_API_KEY_REF=OPENAI_API_KEY
# OPENAI_API_KEY=your-api-key-here

# Option 3: Use Google Gemini
# DEFAULT_LLM_PROVIDER=vertex-ai-gemini
# DEFAULT_LLM_MODEL=gemini-2.5-flash
# DEFAULT_LLM_BASE_URL=https://your-gemini-endpoint
# DEFAULT_LLM_API_KEY_REF=GEMINI_API_KEY
# GEMINI_API_KEY=your-gemini-api-key