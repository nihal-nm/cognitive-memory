# Copy this file to .env and customize the values for local non-container runs.

# Change to true if you want to reset event processing
COGNITION_CHECKPOINT_RESET_ON_STARTUP=false

# Memory Service connection for local host-based runs
MEMORY_SERVICE_GRPC_HOST=localhost
MEMORY_SERVICE_GRPC_PORT=8082
MEMORY_SERVICE_API_KEY=cognition-processor-key-123
MEMORY_SERVICE_CLIENT_ID=cognition_processor

# Worker/runtime identity
COGNITION_WORKER_ID=cognition_processor
COGNITION_RUNTIME_ID=cognition-processor-v1
COGNITION_RUNTIME_VERSION=1.0.0-SNAPSHOT

# ===== Memory Model Configuration =====
# Used for extraction and verification
# Default: OpenAI-compatible endpoint pointing to local Ollama (llama3.2)

# Option 1: Use local Ollama via OpenAI-compatible endpoint (default - no configuration needed)
# This uses Ollama's OpenAI-compatible API at http://localhost:11434/v1
# MEMORY_MODEL_PROVIDER=openai
# MEMORY_MODEL_ID=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=not-needed-for-ollama

# Option 2: Use native Ollama provider
# MEMORY_MODEL_PROVIDER=ollama
# MEMORY_MODEL_ID=llama3.2

# Option 3: Use real OpenAI
# MEMORY_MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL_NAME=gpt-4

# Option 4: Use Google Gemini
# Get an API key from: https://aistudio.google.com/apikey
# MEMORY_MODEL_PROVIDER=vertex-ai-gemini
# MEMORY_MODEL_ID=gemini-2.5-flash-lite
# QUARKUS_LANGCHAIN4J_AI_GEMINI__MEMORY__API_KEY=your-gemini-api-key

# ===== Global LLM Defaults =====
# Used by the resource configuration system for all cognitive processes
# Default: OpenAI-compatible endpoint pointing to local Ollama (llama3.2)

# Option 1: Use local Ollama via OpenAI-compatible endpoint (default - no configuration needed)
# This uses Ollama's OpenAI-compatible API at http://localhost:11434/v1
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=llama3.2
# DEFAULT_LLM_BASE_URL=http://localhost:11434
# DEFAULT_LLM_API_KEY_REF=OPENAI_API_KEY
# OPENAI_API_KEY=not-needed-for-ollama

# Option 2: Use native Ollama provider
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_LLM_MODEL=llama3.2
# DEFAULT_LLM_BASE_URL=http://localhost:11434

# Option 3: Use real OpenAI
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=gpt-4
# DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
# DEFAULT_LLM_API_KEY_REF=OPENAI_API_KEY
# OPENAI_API_KEY=your-openai-api-key-here

# Option 4: Use Google Gemini
# DEFAULT_LLM_PROVIDER=vertex-ai-gemini
# DEFAULT_LLM_MODEL=gemini-2.5-flash
# DEFAULT_LLM_BASE_URL=https://your-gemini-endpoint
# DEFAULT_LLM_API_KEY_REF=GEMINI_API_KEY
# GEMINI_API_KEY=your-gemini-api-key

# For Docker-based runs, use .env.docker.example as the starting point.