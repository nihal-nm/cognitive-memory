# Copy this file to .env and customize the values.

# Change to true if you want to reset event processing
COGNITION_CHECKPOINT_RESET_ON_STARTUP=false

# Uncomment to use Google Gemini.
# Get an API key from: https://aistudio.google.com/apikey
# QUARKUS_LANGCHAIN4J_AI_GEMINI__MEMORY__API_KEY=...
# QUARKUS_LANGCHAIN4J_AI_GEMINI__TOPIC_SUMMARY__API_KEY=...
# QUARKUS_LANGCHAIN4J_MEMORY_CHAT_MODEL_PROVIDER=ai-gemini
# QUARKUS_LANGCHAIN4J_TOPIC_SUMMARY_CHAT_MODEL_PROVIDER=ai-gemini
# QUARKUS_LANGCHAIN4J_AI_GEMINI__MEMORY__CHAT_MODEL_MODEL_ID=gemini-2.5-flash-lite
# QUARKUS_LANGCHAIN4J_AI_GEMINI__TOPIC_SUMMARY__CHAT_MODEL_MODEL_ID=gemini-2.5-flash-lite
