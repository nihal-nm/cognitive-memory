<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated protobuf code -->
    <Match>
        <Package name="~io\.github\.chirino\.memory\.grpc\..*"/>
    </Match>

    <!-- CDI/Quarkus managed beans: internal representation exposure is not a risk -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- CDI singletons are not serialized -->
    <Match>
        <Bug pattern="SING_SINGLETON_IMPLEMENTS_SERIALIZABLE"/>
    </Match>
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <!-- Broad catch is intentional for resilience in event handlers and job processors -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- RuntimeException wrapping of checked exceptions is standard in CDI beans -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>

    <!-- \n is intentional in format strings used for LLM prompts, not platform output -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- Defensive null checks on @NonNull values are harmless -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- Anonymous LlmResourceConfiguration inline classes are intentional; refactoring to
         named static inner classes would add boilerplate without benefit in CDI beans -->
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON"/>
    </Match>
</FindBugsFilter>
